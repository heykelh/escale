# AeroDataBox via RapidAPI (self-serve, plan Basic gratuit)
# RapidAPI -> AeroDataBox -> Subscribe (Basic) -> copie ta cle "X-RapidAPI-Key"
RAPIDAPI_KEY=xxxxx

# Supabase: Settings -> Database -> Connection string (Session pooler)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# Fenetre d'ingestion en heures (max 12 par appel FIDS)
WINDOW_HOURS=12

# Optionnel: alerting MCO
NTFY_TOPIC=
